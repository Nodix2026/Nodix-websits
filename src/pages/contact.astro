---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Request a Quote | Nodix Solar PV Tools" description="Request pricing, specifications, samples or private-label options for solar PV installation tools.">
  <section class="page-hero"><div class="kicker">NODIX / RFQ</div><h1>Tell us what<br/>you need.</h1><p>Send the product, quantity and specification you are working with. For private label or custom kits, include the target market and packaging requirement.</p></section>
  <section class="rfq-layout">
    <aside class="rfq-side">
      <div class="rfq-note"><span class="kicker">WHAT TO INCLUDE</span><h3>Make the first quote easier.</h3><p>You do not need to have every detail ready. Even a product photo, cable size, connector type or target quantity is enough to start.</p></div>
      <div class="rfq-list"><div><b>01</b><span>Product / tool type</span></div><div><b>02</b><span>Quantity or sample request</span></div><div><b>03</b><span>Specification / application</span></div><div><b>04</b><span>Packaging / branding, if required</span></div></div>
      <div class="rfq-contact"><small>DIRECT EMAIL</small><a href="mailto:sales@nodixglobal.com">sales@nodixglobal.com</a><p>No portal or account is required. You can also email a product photo, specification or reference directly.</p></div>
    </aside>
    <div class="form-wrap">
      <form class="form-grid" id="rfq-form">
        <div class="field"><label>Name *</label><input name="name" autocomplete="name" required /></div><div class="field"><label>Work Email *</label><input type="email" name="email" autocomplete="email" required /></div>
        <div class="field"><label>Company</label><input name="company" autocomplete="organization" /></div><div class="field"><label>Country / Market</label><input name="country" autocomplete="country-name" /></div>
        <div class="field"><label>Product Interest</label><select name="product"><option>PV Crimping Tool</option><option>PV Cable Stripper</option><option>PV Cable Cutter</option><option>PV Connector Tools</option><option>PV Installer Tool Kit</option><option>OEM / Custom</option><option>Other / Not sure</option></select></div><div class="field"><label>Estimated Quantity</label><select name="quantity"><option>Sample</option><option>10–50 pcs</option><option>50–500 pcs</option><option>500+ pcs</option><option>Not sure</option></select></div>
        <div class="field"><label>Cable / Connector Specification</label><input name="specification" placeholder="Cable size, connector system, terminal type, or other known requirement" /></div><div class="field"><label>Packaging / Branding</label><select name="packaging"><option>Standard packaging</option><option>Private label</option><option>Custom kit / packaging</option><option>Not sure</option></select></div>
        <div class="field full"><label>Requirement</label><textarea name="message" placeholder="Tell us what you are trying to source, your target quantity, application or any reference product. You can also mention a target price if relevant."></textarea></div>
        <div class="field full form-submit"><button class="btn primary" type="submit">Prepare Inquiry ↗</button><span class="form-hint" id="form-status">Your email client will open with the inquiry details filled in.</span></div>
      </form>
    </div>
  </section>
  <section class="section rfq-process">
    <div class="section-head"><h2>What happens<br/>after you inquire.</h2><p>Keep the first message simple. We can work from the information you already have and confirm the details needed for the next step.</p></div>
    <div class="process-grid">
      <div><span>01</span><strong>REVIEW</strong><p>We review the product, application, quantity and any reference information you provide.</p></div>
      <div><span>02</span><strong>CONFIRM</strong><p>We check the applicable configuration, documentation, packaging and factory availability.</p></div>
      <div><span>03</span><strong>QUOTE</strong><p>We discuss the commercial details, sample requirement or private-label direction with you.</p></div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const form = document.getElementById('rfq-form');
  const requestedProduct = new URLSearchParams(window.location.search).get('product');
  if (requestedProduct) {
    const select = form?.querySelector('select[name=product]');
    const labels = {
      'pv-crimping-tool':'PV Crimping Tool',
      'pv-cable-stripper':'PV Cable Stripper',
      'pv-cable-cutter':'PV Cable Cutter',
      'pv-connector-tools':'PV Connector Tools',
      'pv-installer-tool-kit':'PV Installer Tool Kit'
    };
    if (select && labels[requestedProduct]) select.value = labels[requestedProduct];
  }
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const subject = `Nodix RFQ — ${data.get('product') || 'PV Tool Inquiry'}`;
    const body = [
      `Name: ${data.get('name') || ''}`,
      `Work Email: ${data.get('email') || ''}`,
      `Company: ${data.get('company') || ''}`,
      `Country / Market: ${data.get('country') || ''}`,
      `Product Interest: ${data.get('product') || ''}`,
      `Estimated Quantity: ${data.get('quantity') || ''}`,
      `Cable / Connector Specification: ${data.get('specification') || ''}`,
      `Packaging / Branding: ${data.get('packaging') || ''}`,
      '',
      `Requirement:`,
      `${data.get('message') || ''}`
    ].join('\n');
    window.location.href = `mailto:sales@nodixglobal.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    if (status) status.textContent = 'Inquiry prepared. Complete and send it from your email client.';
  });
</script>
