---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';
---
<BaseLayout title="Products | Nodix Solar PV Tools" description="Solar PV installation tools including crimping tools, cable strippers, cable cutters, connector tools and installer kits.">
  <section class="page-hero"><div class="kicker">NODIX / PRODUCTS</div><h1>Professional<br/>PV tools.</h1><p>A focused range for cable preparation, connector assembly and solar installation. Each product has a clear reference so specifications, samples and quotations can be discussed precisely.</p></section>
  <section class="product-intro"><div><span class="kicker">A FOCUSED RANGE</span><h2>Built around the<br/>PV installation workflow.</h2></div><p>We keep the range deliberately narrow: fewer generic products, more attention to the tools installers actually use. Start with an individual tool, or ask us to build a compact kit around your market and quantity.</p></section>
  <section class="section" style="padding-top:34px"><div class="category-strip"><span>01 / CABLE PREPARATION</span><span>02 / CONNECTOR TOOLS</span><span>03 / INSTALLATION KITS</span></div><div class="products-grid">{products.map((product)=><a class="product-card" href={`/products/${product.slug}`}><div class="product-image">{product.image ? <img src={product.image} alt={product.name} loading="lazy" /> : <div class="image-placeholder"><span>IMAGE / COMING SOON</span></div>}</div><div class="product-meta"><small>{product.eyebrow}</small><h3>{product.name}</h3><p>{product.short}</p><div class="product-ref">{product.sku}</div></div><div class="arrow">VIEW PRODUCT ↗</div></a>)}</div></section>
  <section class="cta-band"><div class="cta-inner"><div><div class="kicker" style="color:#17120e">B2B / RFQ</div><h2>Need a specific<br/>configuration?</h2></div><a class="btn" href="/contact">Request a Quote ↗</a></div></section>
</BaseLayout>
