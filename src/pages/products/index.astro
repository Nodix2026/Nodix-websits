---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, products } from '../../data/products';

const categoryCount = (categoryName) => products.filter((product) => product.category === categoryName).length;
const categoryImage = (categoryName) => products.find((product) => product.category === categoryName)?.image;
---
<BaseLayout title="Products | Nodix Solar PV Tools" description="Solar PV installation tools organized by product category, tool type and product reference for distributors, installers and professional buyers.">
  <section class="page-hero"><div class="kicker">NODIX / PRODUCTS</div><h1>Professional<br/>PV tools.</h1><p>A structured product catalogue for cable preparation, connector tools and installation kits. Browse by tool family first, then by specific product type and model.</p></section>

  <section class="section category-directory">
    <div class="section-head"><div><span class="kicker">PRODUCT CATEGORIES</span><h2>Choose a tool family.</h2></div><p>Start with the type of PV work you need to support. Each family can grow into multiple tool types, models and configurations.</p></div>
    <div class="category-cards category-cards-four">
      {categories.map((category) => <a class="category-card" href={`/products/category/${category.slug}`}>
        <div class="category-card-media">{categoryImage(category.name) ? <img src={categoryImage(category.name)} alt="" loading="lazy" /> : <span>COMING SOON</span>}<span class="category-number">{category.number} / {String(categoryCount(category.name)).padStart(2, '0')} PRODUCTS</span></div>
        <div class="category-card-body"><h3>{category.name}</h3><p>{category.description}</p></div>
        <div class="category-card-footer"><span>{category.subcategories.length} product types</span><span class="category-arrow">VIEW CATEGORY ↗</span></div>
      </a>)}
    </div>
  </section>

  <section class="section catalogue-map">
    <div class="section-head"><div><span class="kicker">CATALOGUE STRUCTURE</span><h2>Category → type → product.</h2></div><p>This structure lets us add different sizes, colors, professional versions and tool kits without turning the Products page into one long list.</p></div>
    <div class="catalogue-levels">
      <div><span>01</span><strong>PRODUCT FAMILY</strong><p>Cable Preparation / Connector Tools / Installation Kits / Maintenance Tools</p></div>
      <div><span>02</span><strong>TOOL TYPE</strong><p>PV Crimping Tools / Cable Strippers / Cable Cutters / Installer Tool Kits</p></div>
      <div><span>03</span><strong>PRODUCT / CONFIGURATION</strong><p>Specific SKU, model, size, color, package or professional configuration.</p></div>
    </div>
  </section>

  <section class="cta-band"><div class="cta-inner"><div><div class="kicker" style="color:#17120e">B2B / RFQ</div><h2>Can't find the<br/>right configuration?</h2></div><a class="btn" href="/contact">Request a Quote ↗</a></div></section>
</BaseLayout>
