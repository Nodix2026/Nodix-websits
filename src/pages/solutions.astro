---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Solutions | Nodix Solar PV Tools"
  description="Solar PV installation tools, OEM programs and factory-backed sourcing solutions for distributors and professional buyers."
>

  <section class="page-hero">
    <div class="kicker">NODIX / SOLUTIONS</div>

    <h1>
      Tools around<br />
      <em>the real workflow.</em>
    </h1>

    <p>
      We keep the range focused on the tasks that happen around PV cable
      preparation, connector assembly, installation and field service.
    </p>
  </section>


  <!-- SOLUTIONS BY WORKFLOW -->

  <section class="section workflow-section">

    <div class="section-head">
      <div>
        <div class="kicker">SOLUTIONS BY WORKFLOW</div>

        <h2>
          Built around<br />
          <em>real PV work.</em>
        </h2>
      </div>

      <p>
        From cable preparation to connector assembly and field maintenance,
        Nodix focuses on practical tools used throughout the solar PV
        installation workflow.
      </p>
    </div>


    <div class="solution-grid">

      <!-- 01 -->

      <article class="solution-card">

        <div class="solution-image">
          <img
            src="/images/solutions/Cable-Preparation.png"
            alt="Solar PV cable preparation tools"
          />
        </div>

        <div class="solution-content">

          <span class="solution-number">01</span>

          <h3>Cable Preparation</h3>

          <p>
            Cutting, stripping and preparation tools for solar PV cables,
            designed for accurate and repeatable installation work.
          </p>

          <a href="/products/cable-preparation">
            Explore tools ↗
          </a>

        </div>

      </article>


      <!-- 02 -->

      <article class="solution-card">

        <div class="solution-image">
          <img
            src="/images/solutions/Connector-Assembly.png"
            alt="Solar PV connector assembly tools"
          />
        </div>

        <div class="solution-content">

          <span class="solution-number">02</span>

          <h3>Connector Assembly</h3>

          <p>
            Crimping, assembly and disconnect tools for professional PV
            connector installation and service.
          </p>

          <a href="/products/connector-tools">
            Explore tools ↗
          </a>

        </div>

      </article>


      <!-- 03 -->

      <article class="solution-card">

        <div class="solution-image">
          <img
            src="/images/solutions/Solar-PV-Installation.png"
            alt="Solar PV installation tools"
          />
        </div>

        <div class="solution-content">

          <span class="solution-number">03</span>

          <h3>Solar PV Installation</h3>

          <p>
            Practical hand tools and configurable tool combinations for
            installers working on solar PV systems.
          </p>

          <a href="/products/installation-kits">
            Explore tools ↗
          </a>

        </div>

      </article>


      <!-- 04 -->

      <article class="solution-card">

        <div class="solution-image">
          <img
            src="/images/solutions/Field-Maintenance.png"
            alt="Solar PV field maintenance tools"
          />
        </div>

        <div class="solution-content">

          <span class="solution-number">04</span>

          <h3>Field Maintenance</h3>

          <p>
            Tools for inspection, maintenance and field service across
            solar PV installation environments.
          </p>

          <a href="/products/maintenance-tools">
            Explore tools ↗
          </a>

        </div>

      </article>

    </div>

  </section>


  <!-- DISTRIBUTORS / INSTALLERS / OEM / CUSTOM -->

  <section class="section">

    <div class="section-head">

      <div>
        <div class="kicker">WHO WE WORK WITH</div>

        <h2>
          Practical supply<br />
          for professional buyers.
        </h2>
      </div>

      <p>
        Whether you are building a product range, supplying installation
        teams or developing your own private-label program, we can start
        from the tools and requirements you already have.
      </p>

    </div>


    <div class="split">

      <div class="dark-panel">

        <div class="kicker">01 / DISTRIBUTORS</div>

        <h3>Focused product ranges.</h3>

        <p>
          Select complementary PV tools for your existing solar, electrical
          or hardware channel. Product combinations and quantities can be
          discussed around your program.
        </p>

      </div>


      <div class="dark-panel">

        <div class="kicker">02 / INSTALLERS</div>

        <h3>Tools for field work.</h3>

        <p>
          Source the core hand tools used by installation and service teams
          without building a catalogue around unrelated products.
        </p>

      </div>


      <div class="dark-panel" id="oem">

        <div class="kicker">03 / OEM</div>

        <h3>Private-label supply.</h3>

        <p>
          Discuss logo application, packaging, tool combinations and
          product documentation for your own brand or distributor program.
        </p>

      </div>


      <div class="dark-panel">

        <div class="kicker">04 / CUSTOM</div>

        <h3>Build a practical kit.</h3>

        <p>
          Start with the installation tasks, then define the tool
          combination and packaging. Customization can follow the product
          requirement rather than the other way around.
        </p>

      </div>

    </div>

  </section>


  <!-- CAPABILITIES -->

  <section class="section">

    <div class="section-head">

      <div>
        <div class="kicker">WHAT WE CAN SUPPORT</div>

        <h2>
          From product<br />
          to supply program.
        </h2>
      </div>

      <p>
        Bring us a reference product, target quantity, cable size, connector
        system or packaging idea. We can start from the information you
        already have.
      </p>

    </div>


    <div class="capability-list">

      <div>
        <strong>PRODUCT SOURCING</strong>
        <span>
          PV cable cutters, strippers, crimpers and connector tools.
        </span>
      </div>

      <div>
        <strong>TOOL COMBINATIONS</strong>
        <span>
          Installer-focused kits built around defined tasks.
        </span>
      </div>

      <div>
        <strong>OEM / PRIVATE LABEL</strong>
        <span>
          Logo, packaging and distributor-oriented product programs.
        </span>
      </div>

      <div>
        <strong>DOCUMENTATION</strong>
        <span>
          Product specifications and applicable factory documentation as confirmed.
        </span>
      </div>

    </div>

  </section>


  <!-- CTA -->

  <section class="cta-band">

    <div class="cta-inner">

      <div>
        <div class="kicker">B2B / RFQ</div>

        <h2>
          Have a specific requirement?
        </h2>
      </div>

      <a class="btn" href="/contact">
        Start a Conversation ↗
      </a>

    </div>

  </section>


  <style>

    .workflow-section {
      overflow: hidden;
    }

    .solution-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
      margin-top: 48px;
    }

    .solution-card {
      background: #11110f;
      border: 1px solid rgba(255,255,255,0.10);
      overflow: hidden;
      transition:
        transform 0.25s ease,
        border-color 0.25s ease;
    }

    .solution-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255,122,0,0.55);
    }

    .solution-image {
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #1a1a18;
    }

    .solution-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .solution-content {
      padding: 28px 30px 32px;
    }

    .solution-number {
      display: block;
      margin-bottom: 12px;
      color: #ff7900;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
    }

    .solution-content h3 {
      margin: 0 0 12px;
      font-size: 28px;
      line-height: 1.1;
    }

    .solution-content p {
      margin: 0 0 22px;
      color: rgba(255,255,255,0.68);
      line-height: 1.7;
      max-width: 560px;
    }

    .solution-content a {
      color: #ff7900;
      text-decoration: none;
      font-weight: 600;
    }

    .solution-content a:hover {
      text-decoration: underline;
    }

    @media (max-width: 800px) {

      .solution-grid {
        grid-template-columns: 1fr;
        gap: 18px;
        margin-top: 32px;
      }

      .solution-content {
        padding: 22px 22px 26px;
      }

      .solution-content h3 {
        font-size: 24px;
      }

    }

  </style>

</BaseLayout>
