---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/products';
import '../styles/global.css';

const featuredProducts = products.slice(0, 6);
---

<BaseLayout
  title="Nodix | Solar PV Installation Tools"
  description="Factory-backed solar PV installation tools for distributors, installers and professional buyers."
>

  <!-- HERO -->
  <section class="home-hero">

    <div class="home-hero-copy">

      <div class="kicker">
        FACTORY-BACKED / SOLAR PV INSTALLATION TOOLS
      </div>

      <h1>
        Tools built for<br/>
        <em>the PV field.</em>
      </h1>

      <p>
        Professional tools for cable preparation, connector assembly
        and solar installation — backed by real factory production
        and B2B supply.
      </p>

      <div class="actions">
        <a class="btn primary" href="/products">
          Explore Products ↗
        </a>

        <a class="btn" href="/contact">
          Request a Quote
        </a>
      </div>

    </div>


    <div class="home-hero-image">

      <img
        src="/images/factory/factory-gate.jpg"
        alt="Nodix solar PV tools manufacturing facility"
      />

      <div class="home-hero-image-label">
        <span>OUR FACTORY</span>
        <small>ESTABLISHED 2021</small>
      </div>

    </div>

  </section>


  <!-- PRODUCT CATEGORIES -->
  <section class="section home-categories">

    <div class="section-head">

      <div>
        <div class="kicker">01 / PRODUCT RANGE</div>

        <h2>
          Tools for the<br/>
          <em>PV workflow.</em>
        </h2>
      </div>

      <p>
        A focused range covering the practical hand-tool stages of
        solar cable preparation, connector assembly and field work.
      </p>

    </div>


    <div class="category-grid">

      <a href="/products" class="category-card">
        <span>01</span>
        <h3>CABLE<br/>PREPARATION</h3>
        <p>Cutters, strippers and preparation tools.</p>
        <b>EXPLORE ↗</b>
      </a>

      <a href="/products" class="category-card">
        <span>02</span>
        <h3>CONNECTOR<br/>TOOLS</h3>
        <p>Crimping and connector handling tools.</p>
        <b>EXPLORE ↗</b>
      </a>

      <a href="/products" class="category-card">
        <span>03</span>
        <h3>INSTALLATION<br/>KITS</h3>
        <p>Practical tool combinations for field work.</p>
        <b>EXPLORE ↗</b>
      </a>

      <a href="/products" class="category-card">
        <span>04</span>
        <h3>FIELD &<br/>MAINTENANCE</h3>
        <p>Tools for installation, service and maintenance.</p>
        <b>EXPLORE ↗</b>
      </a>

    </div>

  </section>


  <!-- WORKFLOW -->
  <section class="section home-workflow">

    <div class="section-head">

      <div>
        <div class="kicker">02 / WORKFLOW</div>

        <h2>
          From cable<br/>
          <em>to connection.</em>
        </h2>
      </div>

      <p>
        Our product range follows the real sequence of PV installation
        work rather than unrelated tool categories.
      </p>

    </div>


    <div class="workflow-grid">

      <div class="step">
        <b>01</b>
        <h3>CUT</h3>
        <p>Prepare clean cable lengths for installation.</p>
      </div>

      <div class="step">
        <b>02</b>
        <h3>STRIP</h3>
        <p>Remove insulation consistently and accurately.</p>
      </div>

      <div class="step">
        <b>03</b>
        <h3>CRIMP</h3>
        <p>Crimp terminals with the correct tool profile.</p>
      </div>

      <div class="step">
        <b>04</b>
        <h3>CONNECT</h3>
        <p>Assemble and service PV connector systems.</p>
      </div>

    </div>

  </section>


  <!-- PRODUCTS -->
  <section class="section">

    <div class="section-head">

      <div>
        <div class="kicker">03 / PRODUCTS</div>

        <h2>
          Professional<br/>
          <em>PV tools.</em>
        </h2>
      </div>

      <p>
        A focused range of practical installation tools, developed
        around real applications and professional buying requirements.
      </p>

    </div>


    <div class="products-grid">

      {featuredProducts.map((product) => (

        <a
          class="product-card"
          href={`/products/${product.slug}`}
        >

          <div class="product-image">

            {product.image
              ? <img
                  src={product.image}
                  alt={product.name}
                  loading="lazy"
                />
              : <div class="image-placeholder">
                  <span>IMAGE / COMING SOON</span>
                </div>
            }

          </div>

          <div class="product-meta">

            <small>{product.eyebrow}</small>

            <h3>{product.name}</h3>

            <p>{product.short}</p>

          </div>

          <div class="arrow">
            VIEW PRODUCT ↗
          </div>

        </a>

      ))}

    </div>


    <div class="section-action">

      <a class="btn" href="/products">
        View All Products ↗
      </a>

    </div>

  </section>


  <!-- FACTORY -->
  <section class="factory-home">

    <div class="factory-home-image">

      <img
        src="/images/factory/production-floor-01.jpg"
        alt="Nodix PV tool production facility"
        loading="lazy"
      />

    </div>


    <div class="factory-home-content">

      <div class="kicker">
        04 / OUR FACTORY
      </div>

      <h2>
        Focused tools.<br/>
        <em>Real production.</em>
      </h2>

      <p>
        Established in 2021, our manufacturing operation supports
        product development, production and export-oriented supply
        for professional PV tools.
      </p>


      <div class="factory-stats">

        <div>
          <strong>1,500</strong>
          <span>m² FACILITY</span>
        </div>

        <div>
          <strong>74</strong>
          <span>EMPLOYEES</span>
        </div>

        <div>
          <strong>34</strong>
          <span>EQUIPMENT</span>
        </div>

        <div>
          <strong>100+</strong>
          <span>NEW MODELS / YEAR</span>
        </div>

      </div>


      <a class="btn" href="/about">
        Explore Our Factory ↗
      </a>

    </div>

  </section>


  <!-- SOLUTIONS -->
  <section class="section">

    <div class="section-head">

      <div>
        <div class="kicker">05 / SOLUTIONS</div>

        <h2>
          Built for<br/>
          <em>B2B buyers.</em>
        </h2>
      </div>

      <p>
        Whether you are building a distributor range, supplying
        installation teams or developing a private-label program,
        we start with the application.
      </p>

    </div>


    <div class="buyer-grid">

      <a href="/solutions#distributors">

        <span>01</span>

        <h3>Distributors</h3>

        <p>
          Focused SKUs, packaging options and repeatable supply
          for your product range.
        </p>

        <b>VIEW SOLUTION ↗</b>

      </a>


      <a href="/solutions#installers">

        <span>02</span>

        <h3>Installers</h3>

        <p>
          Practical tools for cable preparation, connector handling
          and field service.
        </p>

        <b>VIEW SOLUTION ↗</b>

      </a>


      <a href="/solutions#oem">

        <span>03</span>

        <h3>OEM / PRIVATE LABEL</h3>

        <p>
          Build a branded tool combination around your target
          market and quantity.
        </p>

        <b>VIEW SOLUTION ↗</b>

      </a>

    </div>

  </section>


  <!-- RESOURCES -->
  <section class="section home-resources">

    <div class="section-head">

      <div>
        <div class="kicker">06 / RESOURCES</div>

        <h2>
          Practical<br/>
          <em>PV resources.</em>
        </h2>
      </div>

      <p>
        Product information, technical references and practical
        guides for professional buyers and installation teams.
      </p>

    </div>


    <div class="resource-grid">

      <a class="resource" href="/resources">

        <small>CATALOG / 01</small>

        <h3>
          Product Catalog
        </h3>

        <p>
          Browse the Nodix PV installation tool range.
        </p>

        <span>
          Explore Resources ↗
        </span>

      </a>


      <a class="resource" href="/resources">

        <small>TECHNICAL / 02</small>

        <h3>
          Technical Specifications
        </h3>

        <p>
          Product dimensions, compatibility and technical information.
        </p>

        <span>
          Explore Resources ↗
        </span>

      </a>


      <a class="resource" href="/resources">

        <small>OEM / 03</small>

        <h3>
          OEM / Private Label
        </h3>

        <p>
          Information for distributor and private-label programs.
        </p>

        <span>
          Explore Resources ↗
        </span>

      </a>

    </div>

  </section>


  <!-- FINAL CTA -->
  <section class="cta-band">

    <div class="cta-inner">

      <h2>
        Need a factory-backed<br/>
        PV tool supplier?
      </h2>

      <a class="btn" href="/contact">
        Request a Quote ↗
      </a>

    </div>

  </section>


  <style>

    .home-hero {
     min-height:560px;
     display:grid;
     grid-template-columns:1.05fr .95fr;
     align-items:center;
     gap:40px;
     padding:60px 5vw;
     background:#0a0a09;
}

    .home-hero-copy {
     display:flex;
     flex-direction:column;
     justify-content:center;
     padding:40px 2vw 40px 0;
}

    .home-hero h1 {
      margin:18px 0 25px;
      font-size:clamp(52px,6vw,86px);
      line-height:.95;
    }

    .home-hero-copy p {
      max-width:620px;
      font-size:18px;
      line-height:1.7;
    }

    .home-hero-image {
     position:relative;
     width:100%;
     aspect-ratio:4 / 3;
     max-height:450px;
     overflow:hidden;
}

    .home-hero-image img {
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .home-hero-image-label {
      position:absolute;
      left:28px;
      bottom:28px;
      padding:16px 20px;
      background:rgba(0,0,0,.75);
      backdrop-filter:blur(8px);
    }

    .home-hero-image-label span,
    .home-hero-image-label small {
      display:block;
    }

    .home-hero-image-label span {
      font-size:12px;
      font-weight:700;
      letter-spacing:.12em;
    }

    .home-hero-image-label small {
      margin-top:5px;
      font-size:10px;
      opacity:.65;
      letter-spacing:.1em;
    }


    .category-grid {
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:16px;
    }

    .category-card {
      min-height:260px;
      padding:28px;
      background:#151513;
      display:flex;
      flex-direction:column;
      transition:transform .25s ease;
    }

    .category-card:hover {
      transform:translateY(-4px);
    }

    .category-card span {
      font-size:11px;
      opacity:.55;
    }

    .category-card h3 {
      margin:55px 0 14px;
      font-size:25px;
      line-height:1;
    }

    .category-card p {
      margin:0;
      line-height:1.6;
      opacity:.7;
    }

    .category-card b {
      margin-top:auto;
      font-size:11px;
      letter-spacing:.1em;
    }


    .section-action {
      margin-top:30px;
      display:flex;
      justify-content:center;
    }


    .factory-home {
      display:grid;
      grid-template-columns:1.15fr 1fr;
      background:#151513;
    }

    .factory-home-image {
  min-height:480px;
  max-height:520px;
}

   .factory-home-image img {
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}

    .factory-home-content {
      padding:70px 6vw;
      display:flex;
      flex-direction:column;
      justify-content:center;
    }

    .factory-home-content h2 {
      margin:14px 0 20px;
      font-size:clamp(42px,5vw,68px);
      line-height:.98;
    }

    .factory-home-content p {
      max-width:560px;
      line-height:1.7;
    }

    .factory-stats {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:22px;
      margin:35px 0;
    }

    .factory-stats strong,
    .factory-stats span {
      display:block;
    }

    .factory-stats strong {
      font-size:34px;
    }

    .factory-stats span {
      margin-top:5px;
      font-size:10px;
      letter-spacing:.1em;
      opacity:.6;
    }


    @media (max-width:900px) {

      .home-hero {
        grid-template-columns:1fr;
      }

      .home-hero-copy {
        padding:75px 24px 55px;
      }

      .home-hero-image {
        min-height:420px;
      }

      .category-grid {
        grid-template-columns:1fr 1fr;
      }

      .factory-home {
        grid-template-columns:1fr;
      }

      .factory-home-image {
        min-height:400px;
      }

    }


    @media (max-width:600px) {

      .category-grid {
        grid-template-columns:1fr;
      }

      .category-card {
        min-height:210px;
      }

      .factory-stats {
        grid-template-columns:1fr 1fr;
      }

    }

  </style>

</BaseLayout>
