---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Nodix" description="The requested page could not be found on Nodix.">
  <section class="page-hero error-page">
    <div class="kicker">NODIX / 404</div>
    <h1>Page not<br/><em>found.</em></h1>
    <p>The page may have moved, or the address may be incorrect. Use the links below to continue.</p>
    <div class="actions"><a class="btn primary" href="/products">Explore Products ↗</a><a class="btn" href="/contact">Request a Quote</a></div>
  </section>
</BaseLayout>
